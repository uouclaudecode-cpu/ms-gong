# 이 파일을 .env.local로 복사해서 값을 채우세요. (.env.local은 Git에 올라가지 않아요)
# 배포된 사이트는 Vercel > Project > Settings > Environment Variables에 같은 이름으로 넣습니다.
# 값이 없으면 사이트는 예시 데이터로 동작해요.

# 네이버 개발자센터 > Application 등록 > 검색 API (뉴스·블로그)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공공데이터포털 > '재정경제부_공공기관 채용정보 조회서비스' 활용신청 > 일반 인증키
DATA_GO_KR_KEY=
